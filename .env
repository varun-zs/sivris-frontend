# ════════════════════════════════════════════════════════════════
# SIVRIS — Local environment configuration
# Local development values. Do NOT commit real secrets to source.
# ════════════════════════════════════════════════════════════════

# Base URL of the SIVRIS backend REST API
VITE_API_BASE_URL=http://localhost:8080/api

# Real-time WebSocket endpoint (notifications, live prices)
VITE_WEBSOCKET_URL=ws://localhost:8080/ws

# Syncfusion Document Editor license key
VITE_SYNCFUSION_LICENSE_KEY=

# Mapbox access token (only required if using Mapbox maps)
VITE_MAPBOX_TOKEN=

# Serve in-repo mock data instead of calling the backend.
VITE_USE_MOCK_API=true
